# Local .terraform directories
**/.terraform/*

# .tfstate files — never commit real state, even local/mocked
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# OS/editor cruft
.DS_Store
*.swp

# Terraform plan output files — binary, can contain sensitive values
*.tfplan

# Real tfvars files may contain environment-specific values —
# commit only .tfvars.example files as documentation
*.tfvars
!*.tfvars.example
